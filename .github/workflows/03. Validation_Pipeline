name: 03 • Platform Pipeline Validation

on:
  workflow_dispatch:

  push:
    branches:
      - main
      - develop

  pull_request:
    branches:
      - main

permissions:
  contents: read

env:
  PYTHONUNBUFFERED: "1"
  PYTHONDONTWRITEBYTECODE: "1"
  PIP_DISABLE_PIP_VERSION_CHECK: "1"

jobs:

  platform:

    name: Institutional Platform

    runs-on: ubuntu-latest

    timeout-minutes: 120

    strategy:
      fail-fast: true

    steps:

      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip

      - name: Install Dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -e .[dev]

      #######################################################################
      # Data
      #######################################################################

      - name: Data Pipeline
        run: |
          python -m orchestration.pipelines.data_pipeline

      #######################################################################
      # Factors
      #######################################################################

      - name: Factor Pipeline
        run: |
          python -m orchestration.pipelines.factor_pipeline

      #######################################################################
      # Alpha
      #######################################################################

      - name: Alpha Pipeline
        run: |
          python -m orchestration.pipelines.alpha_pipeline

      #######################################################################
      # Signals
      #######################################################################

      - name: Signal Pipeline
        run: |
          python -m orchestration.pipelines.signal_pipeline

      #######################################################################
      # Risk Model
      #######################################################################

      - name: Risk Model Pipeline
        run: |
          python -m orchestration.pipelines.risk_model_pipeline

      #######################################################################
      # Risk
      #######################################################################

      - name: Risk Pipeline
        run: |
          python -m orchestration.pipelines.risk_pipeline

      #######################################################################
      # Portfolio
      #######################################################################

      - name: Portfolio Pipeline
        run: |
          python -m orchestration.pipelines.portfolio_pipeline

      #######################################################################
      # Execution
      #######################################################################

      - name: Execution Pipeline
        run: |
          python -m orchestration.pipelines.execution_pipeline

      #######################################################################
      # Performance
      #######################################################################

      - name: Performance Pipeline
        run: |
          python -m orchestration.pipelines.performance_pipeline

      #######################################################################
      # Reporting
      #######################################################################

      - name: Reporting Pipeline
        run: |
          python -m orchestration.pipelines.reporting_pipeline

      #######################################################################
      # Live Rebalance
      #######################################################################

      - name: Live Rebalance
        run: |
          python -m analytics.live.live_rebalance_engine

      #######################################################################
      # Master Rebalance
      #######################################################################

      - name: Master Rebalance
        run: |
          python -m orchestration.master_rebalance_engine

      #######################################################################
      # Upload Artifacts
      #######################################################################

      - name: Upload Reports
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: institutional-platform-output
          if-no-files-found: ignore
          path: |
            reports/**
            outputs/**
            artifacts/**
            logs/**
            htmlcov/**
            *.csv
            *.xlsx
            *.pdf
            *.pptx

      #######################################################################
      # Summary
      #######################################################################

      - name: Summary
        if: always()
        run: |
          echo "==========================================="
          echo "Institutional Quant Platform"
          echo "Pipeline Validation Complete"
          echo "==========================================="
