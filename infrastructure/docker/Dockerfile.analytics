# ==============================================================================
# Institutional Quant Platform
# Analytics Engine Dockerfile
# ==============================================================================

# ------------------------------------------------------------------------------
# Builder Stage
# ------------------------------------------------------------------------------

FROM python:3.14-slim AS builder

LABEL stage=builder

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /build

RUN apt-get update && apt-get install -y \
    build-essential \
    gcc \
    g++ \
    git \
    libatlas-base-dev \
    liblapack-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

RUN python -m venv /opt/venv

ENV PATH="/opt/venv/bin:$PATH"

RUN pip install --upgrade pip

RUN pip install --no-cache-dir -r requirements.txt

# ------------------------------------------------------------------------------
# Runtime Stage
# ------------------------------------------------------------------------------

FROM python:3.14-slim

LABEL maintainer="Institutional Quant Platform"
LABEL service="analytics"
LABEL version="1.0.0"

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv

COPY . .

RUN useradd \
    --create-home \
    --shell /bin/bash \
    analytics

RUN chown -R analytics:analytics /app

USER analytics

# ------------------------------------------------------------------------------
# Directories
# ------------------------------------------------------------------------------

RUN mkdir -p \
    /app/logs \
    /app/data \
    /app/cache \
    /app/output

# ------------------------------------------------------------------------------
# Health Check
# ------------------------------------------------------------------------------

HEALTHCHECK \
    --interval=60s \
    --timeout=10s \
    --start-period=30s \
    --retries=3 \
CMD python -c "print('Analytics Engine Healthy')"

# ------------------------------------------------------------------------------
# Environment
# ------------------------------------------------------------------------------

ENV PLATFORM_ENV=production
ENV PLATFORM_MODE=analytics

# ------------------------------------------------------------------------------
# Default Command
# ------------------------------------------------------------------------------

CMD [
    "python",
    "-m",
    "orchestration.run_pipeline"
]