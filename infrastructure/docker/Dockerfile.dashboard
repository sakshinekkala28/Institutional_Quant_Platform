# ==============================================================================
# Institutional Quant Platform
# Dashboard Dockerfile
# ==============================================================================

# ------------------------------------------------------------------------------
# Builder Stage
# ------------------------------------------------------------------------------

FROM python:3.14-slim AS builder

LABEL stage=builder

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /build

RUN apt-get update && apt-get install -y \
    build-essential \
    gcc \
    git \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

RUN python -m venv /opt/venv

ENV PATH="/opt/venv/bin:$PATH"

RUN pip install --upgrade pip

RUN pip install --no-cache-dir -r requirements.txt

# ------------------------------------------------------------------------------
# Runtime Stage
# ------------------------------------------------------------------------------

FROM python:3.14-slim

LABEL maintainer="Institutional Quant Platform"
LABEL service="dashboard"
LABEL version="1.0.0"

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv

COPY . .

# ------------------------------------------------------------------------------
# Create Non-root User
# ------------------------------------------------------------------------------

RUN useradd \
    --create-home \
    --shell /bin/bash \
    dashboard

RUN chown -R dashboard:dashboard /app

USER dashboard

# ------------------------------------------------------------------------------
# Runtime Directories
# ------------------------------------------------------------------------------

RUN mkdir -p \
    /app/logs \
    /app/cache \
    /app/data

# ------------------------------------------------------------------------------
# Streamlit Configuration
# ------------------------------------------------------------------------------

RUN mkdir -p /home/dashboard/.streamlit

RUN printf "\
[server]\n\
headless = true\n\
port = 8501\n\
address = \"0.0.0.0\"\n\
enableCORS = false\n\
enableXsrfProtection = true\n\
\n\
[browser]\n\
gatherUsageStats = false\n\
\n\
[theme]\n\
base = \"dark\"\n" \
> /home/dashboard/.streamlit/config.toml

# ------------------------------------------------------------------------------
# Environment
# ------------------------------------------------------------------------------

ENV PLATFORM_ENV=production
ENV PLATFORM_MODE=dashboard

EXPOSE 8501

# ------------------------------------------------------------------------------
# Health Check
# ------------------------------------------------------------------------------

HEALTHCHECK \
    --interval=30s \
    --timeout=5s \
    --start-period=20s \
    --retries=3 \
CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8501')"

# ------------------------------------------------------------------------------
# Default Command
# ------------------------------------------------------------------------------

CMD [
    "streamlit",
    "run",
    "dashboard/app.py",
    "--server.port=8501",
    "--server.address=0.0.0.0"
]